# --- App ---
APP_NAME=Aurevia
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# Local dev example (Postgres). For quick local testing you can swap this
# for sqlite:///./aurevia.db in config.py defaults.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aurevia

# --- Auth ---
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI Service ---
AI_API_KEY=your-ai-provider-api-key
AI_MODEL=claude-sonnet-4-6
AI_API_URL=https://api.anthropic.com/v1/messages
AI_REQUEST_TIMEOUT_SECONDS=30

# --- CORS ---
# Comma-separated list of allowed frontend origins (exact matches).
# Add your teammate's live Vercel URL here.
CORS_ORIGINS=https://aurevia.vercel.app,http://localhost:3000,http://localhost:5173

# Optional: regex to also allow every Vercel preview URL for this project.
# Leave blank if you don't need preview deployments to hit the API.
CORS_ORIGIN_REGEX=https://aurevia-.*\.vercel\.app
